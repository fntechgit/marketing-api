# Logging
# Local log sinks for every logger: comma-separated, `file` and/or `console`.
# Other names are ignored. An empty value leaves no local output (NullHandler): with the
# OTLP bridge on (OTEL_SERVICE_ENABLED below), only OTLP.
LOG_HANDLERS=file,console

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=1qaz2wsx
REDIS_LOCATION='redis://127.0.0.1:6379/1'

# Swift
SWIFT_PROJECT_ID=
SWIFT_BASE_URL=https://object-storage-ca-ymq-1.vexxhost.net/swift/v1/${SWIFT_PROJECT_ID}
SWIFT_AUTH_URL=https://auth.vexxhost.net/v3
SWIFT_APP_CRED_ID=
SWIFT_APP_CRED_SECRET=
SWIFT_PROJECT_NAME=
SWIFT_REGION_NAME=
SWIFT_CONTAINER_NAME=

# S3
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

DEFAULT_FILE_STORAGE=api.utils.storage.s3.S3Storage

OAUTH2_IDP_BASE_URL=
OAUTH2_IDP_INTROSPECTION_ENDPOINT=oauth2/token/introspection
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Seconds the token info stays cached before the token is introspected again (default 30).
OAUTH2_ACCESS_TOKEN_CACHE=30

OAUTH2_ADD_SCOPE=config-values/add config-values/write
OAUTH2_UPDATE_SCOPE=config-values/update config-values/write
OAUTH2_DELETE_SCOPE=config-values/delete config-values/write
OAUTH2_CLONE_SCOPE=config-values/clone config-values/write

# OpenTelemetry (patterns/microservices/observability-otel.md); both gates are off by default
# Logs (base_api_utils.otel_logging)
OTEL_SERVICE_ENABLED=false
OTEL_SERVICE_NAME=marketing-api
# Base URL: /v1/logs and /v1/traces are appended; OTEL_EXPORTER_OTLP_LOGS_ENDPOINT and
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT override it per signal
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#OTEL_EXPORTER_OTLP_HEADERS=
# Replaces the default list: the platform loggers plus every logger settings.LOGGING declares
#OTEL_BRIDGE_LOGGERS=audit,oauth2,django.request,django.server,api,serializers,jobs
# Traces (base_api_utils.otel_instrumentation); OTEL_EXPORTER_MODE is otel_endpoint or console
OTEL_INSTRUMENTATION_ENABLED=false
OTEL_EXPORTER_MODE=otel_endpoint
#OTEL_TRACES_SAMPLER=parentbased_traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1
# Export timeouts are in milliseconds; OTEL_EXPORTER_OTLP_TIMEOUT applies to logs and traces
#OTEL_EXPORTER_OTLP_TIMEOUT=10000
#OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10000
# Local collector (docker compose --profile otel)
OTEL_COLLECTOR_IMAGE_TAG=0.100.0
# UID:GID the collector runs as, to write logs/otel: yours if it is not 1000:1000 (id -u, id -g)
#OTEL_COLLECTOR_USER=1000:1000